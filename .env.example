# ─────────────────────────────────────────────────────────────────────────────
# Repo-level env consumed by `docker compose up` / Dokploy.
# The frontend itself reads NO environment variables — this is Traefik routing
# config only.
# ─────────────────────────────────────────────────────────────────────────────

# Bare hostname (no scheme) Traefik should route to the frontend.
FRONTEND_HOST=kopahi.com
